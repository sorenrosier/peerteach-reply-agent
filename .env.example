# Instantly v2 API key (https://app.instantly.ai/app/settings/integrations)
INSTANTLY_API_KEY=

# Anthropic Claude API key
ANTHROPIC_API_KEY=

# Slack incoming webhook URL (https://api.slack.com/apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=

# Slack bot token with chat:write scope (xoxb-...)
SLACK_BOT_TOKEN=

# Slack app signing secret for verifying interactive payloads
SLACK_SIGNING_SECRET=

# Slack channel ID where escalations / approvals are posted (e.g. C0123456789)
SLACK_CHANNEL_ID=

# Calendly API key — generate at calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=

# Calendly event type URI — find by hitting GET /api/test-autobook with only CALENDLY_API_KEY set
# Looks like: https://api.calendly.com/event_types/XXXXXXXXXXXXXXXXXX
CALENDLY_EVENT_TYPE_URI=

# Optional shared secret. If set, Instantly webhooks must include header x-webhook-secret matching this.
WEBHOOK_SECRET=

# Public base URL of the deployed Vercel app (used for Slack action URLs)
BASE_URL=

# Nightly usage health onto Close leads (src/usageHealth.ts, GET /api/sync-usage-health).
# Close API key (also used by the Close sync)
CLOSE_API_KEY=
# Set to "live" to write to Close; anything else is a dry run that only posts a summary in Slack
USAGE_HEALTH_MODE=
# Shared secret for the Sales Ops usage feed (sent as x-peerteach-usage-secret)
PEERTEACH_USAGE_SECRET=
# Optional: Slack channel ID for the summaries and the Monday "schools that slipped" list.
# Errors and stale-feed warnings always go to SLACK_CHANNEL_ID. The bot must be invited to it.
USAGE_HEALTH_SLACK_CHANNEL=
# Optional: the feed's URL, if it isn't the default Sales Ops one
SALES_OPS_HEALTH_URL=
# Optional: comma-separated teacher IDs to leave out (internal or partner accounts)
HEALTH_EXCLUDED_TEACHER_IDS=
# Optional: the Sales Ops app's address, if it isn't the default (used by the health feed above
# when SALES_OPS_HEALTH_URL is unset, and by the check-in job below)
SALES_OPS_BASE_URL=

# Check-in emails to teachers who stopped running sessions (src/lapseNudges.ts,
# GET /api/send-lapse-nudges). Also needs CLOSE_API_KEY and PEERTEACH_USAGE_SECRET; cards go to
# USAGE_HEALTH_SLACK_CHANNEL, and HEALTH_EXCLUDED_TEACHER_IDS are left out here too.
# Unset or "preview": cards have no Approve button and nothing can be sent. "draft": Approve saves
# a draft in the sender's Close mailbox. "live": Approve sends through Close.
LAPSE_NUDGE_MODE=
# Optional: a date (YYYY-MM-DD, Pacific) on which a run started by hand ignores the weekday and
# holiday rules. Only that one day; summer and a stale feed still stop it.
LAPSE_NUDGE_RUN_ON=
# Optional: whose Close mailbox the emails come from (default katie@peerteach.org)
NUDGE_SENDER_EMAIL=
# Optional: the first name the emails are signed with (default Katie)
NUDGE_SENDER_NAME=
# Optional: a booking link; when set, the first email offers a quick call
NUDGE_CALENDAR_URL=
# Optional: YYYY-MM-DD. Up to and on this date, half the teachers (by teacher ID) get no card and
# are recorded as held out, as a comparison group. Unset = no holdout.
NUDGE_HOLDOUT_UNTIL=
