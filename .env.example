# Instantly v2 API key (https://app.instantly.ai/app/settings/integrations)
INSTANTLY_API_KEY=

# Anthropic Claude API key
ANTHROPIC_API_KEY=

# Slack incoming webhook URL (https://api.slack.com/apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=

# Slack bot token with chat:write scope (xoxb-...)
SLACK_BOT_TOKEN=

# Slack app signing secret for verifying interactive payloads
SLACK_SIGNING_SECRET=

# Slack channel ID where escalations / approvals are posted (e.g. C0123456789)
SLACK_CHANNEL_ID=

# GHL (GoHighLevel) private integration token — DORMANT, only used when AUTO_BOOK_ENABLED=true
GHL_API_KEY=
GHL_CALENDAR_ID=
GHL_LOCATION_ID=

# Optional shared secret. If set, Instantly webhooks must include header x-webhook-secret matching this.
WEBHOOK_SECRET=

# Feature flag: enable GHL auto-booking branch. Default off.
AUTO_BOOK_ENABLED=false

# Public base URL of the deployed Vercel app (used for Slack action URLs)
BASE_URL=
