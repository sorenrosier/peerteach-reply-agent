{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/webhook.ts": { "maxDuration": 60 },
    "api/slack-action.ts": { "maxDuration": 60 },
    "api/cleanup-holds.ts": { "maxDuration": 60 },
    "api/send-reminders.ts": { "maxDuration": 60 },
    "api/sync-calendly-bookings.ts": { "maxDuration": 60 },
    "api/send-followups.ts": { "maxDuration": 120 },
    "api/send-teacher-nudges.ts": { "maxDuration": 60 },
    "api/send-remy-followups.ts": { "maxDuration": 120 },
    "api/sync-close.ts": { "maxDuration": 120 }
  },
  "crons": [
    { "path": "/api/cleanup-holds", "schedule": "0 * * * *" },
    { "path": "/api/send-reminders", "schedule": "*/15 * * * *" },
    { "path": "/api/sync-calendly-bookings", "schedule": "*/15 * * * *" },
    { "path": "/api/send-followups", "schedule": "20 * * * *" },
    { "path": "/api/send-teacher-nudges", "schedule": "40 * * * *" },
    { "path": "/api/send-remy-followups", "schedule": "45 12-22 * * 1-5" },
    { "path": "/api/sync-close", "schedule": "5,20,35,50 * * * *" }
  ]
}
